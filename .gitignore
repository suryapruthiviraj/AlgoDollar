# Downloaded market data — reproducible via app/data/providers.py, not source.
# 39MB of vendor parquet does not belong in git; the acquisition code does.
data_cache/

# TypeScript incremental build cache — regenerated on every build.
*.tsbuildinfo

# Runtime execution state. NOT source, and never to be committed:
# - paper_broker_state.json is a simulated account's positions and cash
# - execution_audit.jsonl is the append-only record of every order attempt
# Both are per-deployment, both are regenerated, and the audit journal is
# operational evidence rather than something a clone should inherit.
backend/data/
