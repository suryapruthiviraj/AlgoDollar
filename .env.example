# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:8000/api/v1/auth/kite/callback

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://algodollar:algodollar_password@localhost:5432/algodollar
DATABASE_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change_this_to_a_secure_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]

# ── Trading Mode (paper/live) — MUST be 'paper' for safety ───────────────────
TRADING_MODE=paper

# ── LLM (optional explanation layer) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
